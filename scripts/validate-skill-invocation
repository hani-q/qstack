#!/usr/bin/env python3

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

try:
    from strictyaml import YAMLError, load as load_yaml
except ModuleNotFoundError:
    YAMLError = None
    load_yaml = None


CLAUDE_FIELD = "disable-model-invocation"
CODEX_FIELD = "allow_implicit_invocation"


def split_frontmatter(skill_md: Path) -> tuple[list[str], int]:
    lines = skill_md.read_text(encoding="utf-8").splitlines(keepends=True)
    if not lines or lines[0].rstrip("\r\n") != "---":
        raise ValueError("SKILL.md must start with YAML frontmatter")

    for index, line in enumerate(lines[1:], start=1):
        if line.rstrip("\r\n") == "---":
            return lines, index

    raise ValueError("SKILL.md frontmatter has no closing delimiter")


def scalar_value(raw: str) -> str:
    return re.sub(r"\s+#.*$", "", raw).strip()


def claude_policy(skill_md: Path) -> tuple[bool, str]:
    lines, closing_index = split_frontmatter(skill_md)
    matches: list[tuple[int, str]] = []
    pattern = re.compile(rf"^{re.escape(CLAUDE_FIELD)}\s*:(.*)$")

    for index, line in enumerate(lines[1:closing_index], start=1):
        match = pattern.match(line.rstrip("\r\n"))
        if match:
            matches.append((index, scalar_value(match.group(1))))

    if len(matches) > 1:
        raise ValueError(f"{CLAUDE_FIELD} appears more than once")

    if not matches:
        return True, "".join(lines)

    field_index, value = matches[0]
    if value != "true":
        raise ValueError(
            f"{CLAUDE_FIELD} must be true when present; omit it for automatic invocation"
        )

    normalized = "".join(lines[:field_index] + lines[field_index + 1 :])
    return False, normalized


def codex_policy(openai_yaml: Path) -> bool:
    if not openai_yaml.is_file():
        raise ValueError("agents/openai.yaml is required")

    text = openai_yaml.read_text(encoding="utf-8")
    try:
        document = load_yaml(text)
    except YAMLError as error:
        raise ValueError(f"agents/openai.yaml is invalid YAML: {error}") from error

    data = document.data
    if not isinstance(data, dict) or not isinstance(data.get("policy"), dict):
        raise ValueError("agents/openai.yaml must contain one policy mapping")

    parsed_value = data["policy"].get(CODEX_FIELD)
    if parsed_value not in {"true", "false"}:
        raise ValueError(f"policy.{CODEX_FIELD} must be true or false")

    lines = text.splitlines()
    policy_lines = [
        index
        for index, line in enumerate(lines)
        if re.fullmatch(r"policy\s*:\s*(?:#.*)?", line)
    ]
    if len(policy_lines) != 1:
        raise ValueError("agents/openai.yaml must contain exactly one top-level policy block")

    values: list[str] = []
    for line in lines[policy_lines[0] + 1 :]:
        if line and not line[0].isspace() and not line.lstrip().startswith("#"):
            break
        match = re.match(rf"^  {re.escape(CODEX_FIELD)}\s*:(.*)$", line)
        if match:
            values.append(scalar_value(match.group(1)))

    if len(values) != 1 or values[0] not in {"true", "false"}:
        raise ValueError(
            f"policy.{CODEX_FIELD} must appear exactly once as a direct, canonical true or false value"
        )

    if values[0] != parsed_value:
        raise ValueError(f"policy.{CODEX_FIELD} does not match its parsed YAML value")

    return values[0] == "true"


def portable_validation(
    skills_ref: str,
    source_dir: Path,
    normalized_skill_md: str,
    temporary_root: Path,
) -> str | None:
    normalized_dir = temporary_root / source_dir.name
    shutil.copytree(source_dir, normalized_dir)
    (normalized_dir / "SKILL.md").write_text(normalized_skill_md, encoding="utf-8")

    result = subprocess.run(
        [skills_ref, "validate", str(normalized_dir)],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    if result.returncode == 0:
        return None

    output = result.stdout.strip().replace(str(normalized_dir), str(source_dir))
    return output or f"skills-ref exited {result.returncode}"


def main() -> int:
    repo = Path(__file__).resolve().parent.parent
    parser = argparse.ArgumentParser(
        description="Validate QStack skill metadata and Claude/Codex invocation parity."
    )
    parser.add_argument("--skills-dir", type=Path, default=repo / "skills")
    parser.add_argument(
        "--skills-ref",
        default=os.environ.get("QSTACK_SKILLS_REF_BIN", "skills-ref"),
    )
    args = parser.parse_args()

    skills_ref = shutil.which(args.skills_ref)
    if not skills_ref:
        print(f"qstack: skills-ref not found: {args.skills_ref}", file=sys.stderr)
        return 1
    if load_yaml is None:
        print(
            "qstack: StrictYAML not found; run this script with the Python "
            "environment that installed skills-ref",
            file=sys.stderr,
        )
        return 1

    skill_dirs = sorted(
        path.parent for path in args.skills_dir.glob("*/SKILL.md") if path.is_file()
    )
    if not skill_dirs:
        print(f"qstack: no skills found in {args.skills_dir}", file=sys.stderr)
        return 1

    failures: list[str] = []
    with tempfile.TemporaryDirectory(prefix="qstack-skill-validation-") as temporary:
        temporary_root = Path(temporary)
        for skill_dir in skill_dirs:
            failure_count = len(failures)
            skill_md = skill_dir / "SKILL.md"
            normalized_skill_md: str | None = None
            claude_auto: bool | None = None
            codex_auto: bool | None = None

            try:
                claude_auto, normalized_skill_md = claude_policy(skill_md)
            except ValueError as error:
                failures.append(f"{skill_dir.name}: {error}")

            try:
                codex_auto = codex_policy(skill_dir / "agents" / "openai.yaml")
            except ValueError as error:
                failures.append(f"{skill_dir.name}: {error}")

            policies_match = (
                claude_auto is not None
                and codex_auto is not None
                and claude_auto == codex_auto
            )
            if claude_auto is not None and codex_auto is not None:
                if not policies_match:
                    expected = "true" if claude_auto else "false"
                    actual = "true" if codex_auto else "false"
                    failures.append(
                        f"{skill_dir.name}: Claude policy requires "
                        f"policy.{CODEX_FIELD}: {expected}, found {actual}"
                    )

            if normalized_skill_md is not None:
                error = portable_validation(
                    skills_ref,
                    skill_dir,
                    normalized_skill_md,
                    temporary_root,
                )
                if error:
                    failures.append(f"{skill_dir.name}: {error}")

            if policies_match and len(failures) == failure_count:
                mode = "automatic" if claude_auto else "manual"
                print(f"qstack: {skill_dir.name}: {mode} in Claude and Codex")

    if failures:
        print("qstack: skill validation failed:", file=sys.stderr)
        for failure in failures:
            print(f"  - {failure}", file=sys.stderr)
        return 1

    print(f"qstack: validated {len(skill_dirs)} skills")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
