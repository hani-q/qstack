#!/usr/bin/env python3

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path
from unittest import mock


SCRIPT = Path(__file__).with_name("qstack-version")
loader = importlib.machinery.SourceFileLoader("qstack_version", str(SCRIPT))
spec = importlib.util.spec_from_loader(loader.name, loader)
assert spec is not None
qstack_version = importlib.util.module_from_spec(spec)
sys.modules[loader.name] = qstack_version
loader.exec_module(qstack_version)


class VersionTests(unittest.TestCase):
    def test_each_bump_resets_lower_components(self) -> None:
        version = qstack_version.Version.parse("1.2.3.4")
        self.assertEqual(str(version.bump("major")), "2.0.0.0")
        self.assertEqual(str(version.bump("minor")), "1.3.0.0")
        self.assertEqual(str(version.bump("patch")), "1.2.4.0")
        self.assertEqual(str(version.bump("micro")), "1.2.3.5")

    def test_three_part_versions_are_rejected(self) -> None:
        with self.assertRaisesRegex(ValueError, "MAJOR.MINOR.PATCH.MICRO"):
            qstack_version.Version.parse("1.2.3")

    def test_legacy_base_versions_normalize_to_micro_zero(self) -> None:
        self.assertEqual(
            str(qstack_version.Version.parse_compatible("1.2.3")), "1.2.3.0"
        )

    def test_allocator_advances_past_highest_claim_at_requested_level(self) -> None:
        base = qstack_version.Version.parse("1.2.3.0")
        claims = [
            {"version": "1.3.0.0"},
            {"version": "1.4.0.0"},
        ]
        self.assertEqual(
            str(qstack_version.next_slot(base, claims, "minor")), "1.5.0.0"
        )
        self.assertEqual(
            str(qstack_version.next_slot(base, claims, "patch")), "1.4.1.0"
        )

    def test_title_rewrite_is_idempotent(self) -> None:
        parser = qstack_version.build_parser()
        args = parser.parse_args(
            [
                "title",
                "--version",
                "1.2.3.4",
                "--title",
                "v1.2.2 feat: add a skill",
            ]
        )
        self.assertEqual(args.title, "v1.2.2 feat: add a skill")
        clean = qstack_version.VERSION_TITLE_RE.sub("", args.title)
        self.assertEqual(f"v1.2.3.4 {clean}", "v1.2.3.4 feat: add a skill")

    def test_changelog_heading_must_match_four_part_format(self) -> None:
        with tempfile.TemporaryDirectory() as directory:
            changelog = Path(directory) / "CHANGELOG.md"
            changelog.write_text(
                "# Changelog\n\n## [2.0.0.0] - 2026-08-24\n", encoding="utf-8"
            )
            self.assertEqual(
                str(qstack_version.first_changelog_version(changelog)), "2.0.0.0"
            )

    def test_changelog_does_not_skip_a_malformed_first_release(self) -> None:
        with tempfile.TemporaryDirectory() as directory:
            changelog = Path(directory) / "CHANGELOG.md"
            changelog.write_text(
                "# Changelog\n\n## 2.0.0 (2026-08-24)\n\n"
                "## [1.0.0.0] - 2026-08-01\n",
                encoding="utf-8",
            )
            with self.assertRaisesRegex(ValueError, "first release heading"):
                qstack_version.first_changelog_version(changelog)


class PrepareIntegrationTests(unittest.TestCase):
    def setUp(self) -> None:
        self.temporary = tempfile.TemporaryDirectory()
        self.root = Path(self.temporary.name)
        subprocess.run(["git", "init", "-q"], cwd=self.root, check=True)
        subprocess.run(
            ["git", "config", "user.email", "qstack@example.invalid"],
            cwd=self.root,
            check=True,
        )
        subprocess.run(
            ["git", "config", "user.name", "QStack Tests"], cwd=self.root, check=True
        )
        (self.root / "version.txt").write_text("1.0.0.0\n", encoding="utf-8")
        (self.root / "CHANGELOG.md").write_text(
            "# Changelog\n\n## [1.0.0.0] - 2026-08-01\n", encoding="utf-8"
        )
        self.claims = self.root / "claims.json"
        self.claims.write_text("[]\n", encoding="utf-8")
        subprocess.run(["git", "add", "."], cwd=self.root, check=True)
        subprocess.run(
            ["git", "commit", "-q", "-m", "initial"], cwd=self.root, check=True
        )

    def tearDown(self) -> None:
        self.temporary.cleanup()

    def prepare(self, claims: list[dict[str, str]] | None = None) -> dict[str, object]:
        if claims is not None:
            self.claims.write_text(json.dumps(claims), encoding="utf-8")
        result = subprocess.run(
            [
                sys.executable,
                str(SCRIPT),
                "prepare",
                "--bump",
                "patch",
                "--current-version",
                "1.0.0.0",
                "--claims-file",
                str(self.claims),
                "--no-worktrees",
                "--no-prs",
            ],
            cwd=self.root,
            check=True,
            stdout=subprocess.PIPE,
            text=True,
        )
        return json.loads(result.stdout)

    def test_prepare_is_idempotent(self) -> None:
        first = self.prepare()
        second = self.prepare()
        self.assertEqual(first["state"], "prepared")
        self.assertEqual(second["state"], "already_prepared")
        self.assertEqual((self.root / "version.txt").read_text(), "1.0.1.0\n")

    def test_prepare_reallocates_only_on_a_real_collision(self) -> None:
        self.prepare()
        (self.root / "CHANGELOG.md").write_text(
            "# Changelog\n\n## [1.0.1.0] - 2026-08-24\n\n"
            "## [1.0.0.0] - 2026-08-01\n",
            encoding="utf-8",
        )
        result = self.prepare(
            [{"source": "pull_request", "version": "1.0.1.0", "pr": "7"}]
        )
        self.assertEqual(result["state"], "reallocated")
        self.assertEqual(result["version"], "1.0.2.0")
        self.assertTrue(result["changelog_updated"])
        self.assertEqual((self.root / "version.txt").read_text(), "1.0.2.0\n")
        self.assertIn(
            "## [1.0.2.0] - 2026-08-24",
            (self.root / "CHANGELOG.md").read_text(encoding="utf-8"),
        )

    def test_prepare_recovers_if_changelog_was_written_before_version(self) -> None:
        self.prepare()
        (self.root / "CHANGELOG.md").write_text(
            "# Changelog\n\n## [1.0.2.0] - 2026-08-24\n\n"
            "## [1.0.0.0] - 2026-08-01\n",
            encoding="utf-8",
        )
        result = self.prepare(
            [{"source": "pull_request", "version": "1.0.1.0", "pr": "7"}]
        )
        self.assertEqual(result["state"], "reallocated")
        self.assertFalse(result["changelog_updated"])
        self.assertEqual((self.root / "version.txt").read_text(), "1.0.2.0\n")

    def test_prepare_fails_closed_when_github_claims_are_incomplete(self) -> None:
        parser = qstack_version.build_parser()
        args = parser.parse_args(
            [
                "prepare",
                "--bump",
                "patch",
                "--current-version",
                "1.0.0.0",
                "--no-worktrees",
            ]
        )
        with mock.patch.object(
            qstack_version,
            "github_claims",
            return_value=([], ["GitHub claims unavailable"], True),
        ):
            with self.assertRaisesRegex(ValueError, "could not be read completely"):
                qstack_version.command_prepare(args, self.root)

        self.assertEqual((self.root / "version.txt").read_text(), "1.0.0.0\n")

    def test_prepared_branch_passes_the_real_check_command(self) -> None:
        self.prepare()
        (self.root / "CHANGELOG.md").write_text(
            "# Changelog\n\n## [1.0.1.0] - 2026-08-24\n\n"
            "## [1.0.0.0] - 2026-08-01\n",
            encoding="utf-8",
        )
        result = subprocess.run(
            [
                sys.executable,
                str(SCRIPT),
                "check",
                "--base-ref",
                "HEAD",
                "--claims-file",
                str(self.claims),
                "--no-worktrees",
                "--no-prs",
            ],
            cwd=self.root,
            check=True,
            stdout=subprocess.PIPE,
            text=True,
        )
        self.assertIn(
            "version 1.0.1.0 advances 1.0.0.0; changelog matches", result.stdout
        )

    def test_check_fails_closed_when_github_claims_are_incomplete(self) -> None:
        self.prepare()
        (self.root / "CHANGELOG.md").write_text(
            "# Changelog\n\n## [1.0.1.0] - 2026-08-24\n\n"
            "## [1.0.0.0] - 2026-08-01\n",
            encoding="utf-8",
        )
        parser = qstack_version.build_parser()
        args = parser.parse_args(["check", "--base-ref", "HEAD", "--no-worktrees"])
        with mock.patch.object(
            qstack_version,
            "github_claims",
            return_value=([], ["GitHub claims unavailable"], True),
        ):
            with self.assertRaisesRegex(ValueError, "failed closed"):
                qstack_version.command_check(args, self.root)


class WorktreeClaimTests(unittest.TestCase):
    def test_active_sibling_worktree_publishes_an_independent_claim(self) -> None:
        with tempfile.TemporaryDirectory() as directory:
            temporary = Path(directory)
            root = temporary / "repo"
            sibling = temporary / "sibling"
            root.mkdir()
            subprocess.run(["git", "init", "-q", "-b", "main"], cwd=root, check=True)
            subprocess.run(
                ["git", "config", "user.email", "qstack@example.invalid"],
                cwd=root,
                check=True,
            )
            subprocess.run(
                ["git", "config", "user.name", "QStack Tests"], cwd=root, check=True
            )
            (root / "version.txt").write_text("1.0.0.0\n", encoding="utf-8")
            subprocess.run(["git", "add", "version.txt"], cwd=root, check=True)
            subprocess.run(
                ["git", "commit", "-q", "-m", "initial"], cwd=root, check=True
            )
            subprocess.run(
                ["git", "worktree", "add", "-q", "-b", "feature", str(sibling)],
                cwd=root,
                check=True,
            )
            (sibling / "version.txt").write_text("1.1.0.0\n", encoding="utf-8")

            claims, warnings, incomplete = qstack_version.worktree_claims(
                root.resolve(), "main", qstack_version.Version.parse("1.0.0.0")
            )

            self.assertEqual(warnings, [])
            self.assertFalse(incomplete)
            self.assertEqual(len(claims), 1)
            self.assertEqual(claims[0]["branch"], "feature")
            self.assertEqual(claims[0]["version"], "1.1.0.0")
            self.assertEqual(claims[0]["source"], "worktree")

    def test_old_sibling_worktree_keeps_its_claim_until_removal(self) -> None:
        with tempfile.TemporaryDirectory() as directory:
            temporary = Path(directory)
            root = temporary / "repo"
            sibling = temporary / "sibling"
            root.mkdir()
            subprocess.run(["git", "init", "-q", "-b", "main"], cwd=root, check=True)
            subprocess.run(
                ["git", "config", "user.email", "qstack@example.invalid"],
                cwd=root,
                check=True,
            )
            subprocess.run(
                ["git", "config", "user.name", "QStack Tests"], cwd=root, check=True
            )
            (root / "version.txt").write_text("1.0.0.0\n", encoding="utf-8")
            subprocess.run(["git", "add", "version.txt"], cwd=root, check=True)
            subprocess.run(
                ["git", "commit", "-q", "-m", "initial"], cwd=root, check=True
            )
            subprocess.run(
                ["git", "worktree", "add", "-q", "-b", "old-feature", str(sibling)],
                cwd=root,
                check=True,
            )
            (sibling / "version.txt").write_text("1.1.0.0\n", encoding="utf-8")

            claims, warnings, incomplete = qstack_version.worktree_claims(
                root.resolve(), "main", qstack_version.Version.parse("1.0.0.0")
            )

            self.assertEqual(warnings, [])
            self.assertFalse(incomplete)
            self.assertEqual(len(claims), 1)
            self.assertEqual(claims[0]["version"], "1.1.0.0")


if __name__ == "__main__":
    unittest.main()
