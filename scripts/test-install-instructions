#!/usr/bin/env bash
#
# Regression test for instruction-file rewriting in ./install.
#
# The interesting case is the *second* install: the first run creates
# AGENTS.md with a hardcoded mode, while every later run has to
# read the existing file's permission bits and reapply them to the temporary
# file it swaps in. Reading a file mode portably is the part that broke. GNU
# stat and BSD stat spell it differently, and GNU stat fails dirtily when given
# the BSD spelling, so the mode came back as filesystem statistics and chmod
# rejected it.
#
# So this runs the installer against a throwaway HOME under four stat flavours:
# whatever this machine ships, a BSD-only stat, a GNU-only stat, and no working
# stat at all. Every branch of file_mode is therefore exercised on every
# platform, including the one that has to refuse rather than guess.
#
# Each flavour covers install, reinstall, symlinked instruction files, and
# uninstall, because both file_mode call sites matter and only one of them is
# on the install path. The throwaway home has a space in its name so the
# installer's quoting stays honest too.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

failures=0

fail() {
  echo "FAIL: $*" >&2
  failures=$((failures + 1))
}

# Read a mode without going through stat, so the shims below cannot influence
# what the assertions see.
mode_of() {
  perl -e 'my @s = stat($ARGV[0]) or die "cannot stat $ARGV[0]\n"; printf "%o\n", $s[2] & 07777' "$1"
}

# A stat that only speaks BSD, like the one on macOS. It reports a real failure
# for a path it cannot read, which is what makes the refusal path testable.
make_bsd_stat() {
  local dir="$1"
  mkdir -p "$dir"
  cat > "$dir/stat" <<'SHIM'
#!/usr/bin/env bash
if [ "$1" = "-f" ] && [ "$2" = "%Lp" ]; then
  perl -e 'my @s = stat($ARGV[0]) or exit 1; printf "%o\n", $s[2] & 07777' "$3"
  exit $?
fi
echo "stat: illegal option -- ${1#-}" >&2
exit 1
SHIM
  chmod +x "$dir/stat"
}

# A stat that only speaks GNU, including its habit of reading -f as
# --file-system. The format string becomes a path, so it reports on the real
# file, complains about the bogus one, and exits non-zero. That combination,
# junk on stdout with a non-zero exit, is the original bug.
make_gnu_stat() {
  local dir="$1"
  mkdir -p "$dir"
  cat > "$dir/stat" <<'SHIM'
#!/usr/bin/env bash
if [ "$1" = "-c" ] && [ "$2" = "%a" ]; then
  perl -e 'my @s = stat($ARGV[0]) or exit 1; printf "%o\n", $s[2] & 07777' "$3"
  exit $?
fi
if [ "$1" = "-f" ]; then
  shift
  status=0
  for path in "$@"; do
    if [ -e "$path" ]; then
      echo "  File: \"$path\""
      echo "    ID: 0 Namelen: 255 Type: ext2/ext3"
      echo "Block size: 4096       Fundamental block size: 4096"
    else
      echo "stat: cannot read file system information for '$path': No such file or directory" >&2
      status=1
    fi
  done
  exit "$status"
fi
echo "stat: invalid option -- ${1#-}" >&2
exit 1
SHIM
  chmod +x "$dir/stat"
}

# A machine with no usable stat at all. The installer must refuse rather than
# invent a mode, because inventing one would widen a file the user kept private.
make_no_stat() {
  local dir="$1"
  mkdir -p "$dir"
  cat > "$dir/stat" <<'SHIM'
#!/usr/bin/env bash
echo "stat: not available here" >&2
exit 1
SHIM
  chmod +x "$dir/stat"
}

install_args=(--copy --without-matt-pocock --without-human-review)

# Only harnesses whose config directory already exists are installed to. A
# symlinked AGENTS.md exercises the dotfile-manager layout. A legacy Claude
# symlink with personal content must survive while its qstack blocks go away.
prepare_home() {
  local home="$1"
  mkdir -p "$home/.claude" "$home/.codex" "$home/dotfiles"
  printf '{"theme":"dark"}\n' > "$home/.claude/settings.json"
  printf '%s\n%s\n%s\n\n%s\n%s\n' \
    '<!-- qstack:general-instructions:start -->' \
    'Old general rules' \
    '<!-- qstack:general-instructions:end -->' \
    '<!-- qstack:instructions:start -->' \
    '<!-- qstack:instructions:end -->' > "$home/dotfiles/claude.md"
  printf '\n## Notes of my own\n\nKeep me.\n' >> "$home/dotfiles/claude.md"
  ln -s "$home/dotfiles/claude.md" "$home/.claude/CLAUDE.md"
  : > "$home/dotfiles/agents.md"
  ln -s "$home/dotfiles/agents.md" "$home/.codex/AGENTS.md"
}

strays_in() {
  find "$1/.claude" "$1/.codex" -maxdepth 1 -name '*.qstack-*' \
    ! -name '.qstack-installed-*' -print
}

run_install() {
  local label="$1" home="$2" stat_dir="$3" log="$4"
  local path="$PATH"
  [ -n "$stat_dir" ] && path="$stat_dir:$PATH"
  shift 4
  PATH="$path" QSTACK_INSTALL_HOME="$home" "$REPO/install" "${install_args[@]}" "$@" >"$log" 2>&1
}

run_case() {
  local label="$1" stat_dir="${2:-}"
  local home="$WORK/home $label"
  local claude="$home/.claude/CLAUDE.md"
  local target="$home/dotfiles/claude.md"
  local codex="$home/.codex/AGENTS.md"
  local codex_target="$home/dotfiles/agents.md"
  local shared="$home/AGENTS.md"
  local log="$WORK/$label.log"

  prepare_home "$home"

  if ! run_install "$label" "$home" "$stat_dir" "$log"; then
    fail "[$label] first install exited non-zero"
    sed 's/^/    /' "$log" >&2
    return
  fi

  [ -L "$claude" ] || { fail "[$label] first install replaced the CLAUDE.md symlink"; return; }
  grep -Fq 'Keep me.' "$target" || { fail "[$label] first install dropped personal Claude content"; return; }
  ! grep -Fq 'qstack:instructions:start' "$target" || fail "[$label] first install left legacy Claude instructions"
  [ -f "$codex" ] || { fail "[$label] first install did not write $codex"; return; }
  [ -L "$codex" ] || fail "[$label] first install replaced the AGENTS.md symlink"
  [ -L "$shared" ] || fail "[$label] first install did not share AGENTS.md with Claude"
  python3 -c 'import json,sys; assert json.load(open(sys.argv[1]))["pluginConfigs"]["agents-md@builtin"]["options"]["instructionFiles"] == "claude-md-and-agents-md"' \
    "$home/.claude/settings.json" || fail "[$label] Claude will skip AGENTS.md in projects with CLAUDE.md"

  # A user-chosen mode and surrounding content both have to survive a rerun.
  chmod 640 "$target"
  chmod 600 "$codex_target"
  printf '\n## My Codex notes\n\nKeep this too.\n' >> "$codex_target"

  if ! run_install "$label" "$home" "$stat_dir" "$log"; then
    fail "[$label] second install exited non-zero"
    sed 's/^/    /' "$log" >&2
    return
  fi

  [ -L "$claude" ] || fail "[$label] second install replaced the CLAUDE.md symlink with a regular file"
  [ -L "$codex" ] || fail "[$label] second install replaced the AGENTS.md symlink with a regular file"
  [ -L "$shared" ] || fail "[$label] second install replaced the shared AGENTS.md symlink"

  local mode
  mode=$(mode_of "$target")
  [ "$mode" = "640" ] || fail "[$label] symlink target mode became $mode, expected 640"
  mode=$(mode_of "$codex")
  [ "$mode" = "600" ] || fail "[$label] AGENTS.md mode became $mode, expected 600"

  grep -Fq 'Keep me.' "$target" || fail "[$label] second install dropped Claude user content"
  grep -Fq 'Keep this too.' "$codex_target" || fail "[$label] second install dropped Codex user content"

  local count file
  for file in "$codex"; do
    count=$(grep -Fxc '<!-- qstack:instructions:start -->' "$file" || true)
    [ "$count" = "1" ] || fail "[$label] $(basename "$file") has $count command blocks, expected 1"
    count=$(grep -Fxc '<!-- qstack:general-instructions:start -->' "$file" || true)
    [ "$count" = "1" ] || fail "[$label] $(basename "$file") has $count general blocks, expected 1"
  done

  # A failed rewrite aborts under set -e and strands its temporary file.
  local strays
  strays=$(strays_in "$home")
  [ -z "$strays" ] || fail "[$label] left temporary files behind: $strays"

  # Uninstall is the second file_mode call site, and nothing else reaches it.
  if ! run_install "$label" "$home" "$stat_dir" "$log" --uninstall; then
    fail "[$label] uninstall exited non-zero"
    sed 's/^/    /' "$log" >&2
    return
  fi

  for file in "$target" "$codex"; do
    grep -Fq '<!-- qstack:instructions:start -->' "$file" \
      && fail "[$label] uninstall left the command block in $(basename "$file")"
    grep -Fq '<!-- qstack:general-instructions:start -->' "$file" \
      && fail "[$label] uninstall left the general block in $(basename "$file")"
  done

  grep -Fq 'Keep me.' "$target" || fail "[$label] uninstall dropped user content"
  grep -Fq 'Keep this too.' "$codex_target" || fail "[$label] uninstall dropped Codex user content"
  [ -L "$claude" ] || fail "[$label] uninstall replaced the CLAUDE.md symlink"
  [ ! -e "$shared" ] || fail "[$label] uninstall left the shared AGENTS.md symlink"
  python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d == {"theme":"dark"}' \
    "$home/.claude/settings.json" || fail "[$label] uninstall did not restore Claude settings"

  mode=$(mode_of "$target")
  [ "$mode" = "640" ] || fail "[$label] symlink target mode became $mode after uninstall, expected 640"
  mode=$(mode_of "$codex")
  [ "$mode" = "600" ] || fail "[$label] AGENTS.md mode became $mode after uninstall, expected 600"

  strays=$(strays_in "$home")
  [ -z "$strays" ] || fail "[$label] uninstall left temporary files behind: $strays"

  echo "ok: $label"
}

# With no readable mode, refusing is the only safe answer: writing a guessed 644
# over a 600 file would hand a private file to every account on the machine.
run_refusal_case() {
  # Separate declarations: bash expands every word of a `local` line before it
  # assigns any of them, so $label is not yet set on the line that defines it.
  local label="no-stat"
  local home="$WORK/home $label"
  local log="$WORK/$label.log"
  local target="$home/dotfiles/claude.md"

  prepare_home "$home"

  if ! run_install "$label" "$home" "" "$log"; then
    fail "[$label] setup install exited non-zero"
    return
  fi
  chmod 600 "$target"

  if run_install "$label" "$home" "$WORK/bin-none" "$log"; then
    fail "[$label] install succeeded with no usable stat; it should have refused"
    return
  fi

  local mode
  mode=$(mode_of "$target")
  [ "$mode" = "600" ] || fail "[$label] refused install still changed the mode to $mode"

  grep -q 'cannot read the mode' "$log" \
    || fail "[$label] refusal did not explain itself: $(tail -1 "$log")"

  local strays
  strays=$(strays_in "$home")
  [ -z "$strays" ] || fail "[$label] refusal left temporary files behind: $strays"

  echo "ok: $label"
}

run_regular_legacy_case() {
  local home="$WORK/home regular-legacy" log="$WORK/regular-legacy.log"
  prepare_home "$home"
  rm "$home/.claude/CLAUDE.md"
  printf '%s\n%s\n%s\n' \
    '<!-- qstack:general-instructions:start -->' \
    'Old instructions' \
    '<!-- qstack:general-instructions:end -->' > "$home/.claude/CLAUDE.md"
  if ! run_install regular-legacy "$home" "" "$log"; then
    fail '[regular-legacy] install exited non-zero'
    return
  fi
  [ ! -e "$home/.claude/CLAUDE.md" ] \
    || fail '[regular-legacy] qstack-only CLAUDE.md was not removed'
}

run_claude_only_case() {
  local home="$WORK/home claude-only" log="$WORK/claude-only.log"
  mkdir -p "$home/.claude"
  if ! run_install claude-only "$home" "" "$log"; then
    fail '[claude-only] install exited non-zero'
    return
  fi
  [ -f "$home/AGENTS.md" ] || fail '[claude-only] shared AGENTS.md was not created'
  grep -Fq '<!-- qstack:instructions:start -->' "$home/AGENTS.md" \
    || fail '[claude-only] qstack instructions were not installed'
}

run_fresh_shared_case() {
  local home="$WORK/home fresh-shared" log="$WORK/fresh-shared.log"
  mkdir -p "$home/.claude" "$home/.codex"
  if ! run_install fresh-shared "$home" "" "$log"; then
    fail '[fresh-shared] install exited non-zero'
    return
  fi
  [ -f "$home/AGENTS.md" ] || fail '[fresh-shared] home AGENTS.md was not created'
  [ -L "$home/.codex/AGENTS.md" ] || fail '[fresh-shared] Codex AGENTS.md was not linked'
  [ "$(readlink "$home/.codex/AGENTS.md")" = "$home/AGENTS.md" ] \
    || fail '[fresh-shared] Codex link does not point to the shared file'
  if ! run_install fresh-shared "$home" "" "$log" --uninstall; then
    fail '[fresh-shared] uninstall exited non-zero'
    return
  fi
  [ ! -e "$home/.codex/AGENTS.md" ] || fail '[fresh-shared] uninstall left the Codex link'
}

run_conflict_case() {
  local home="$WORK/home conflict" log="$WORK/conflict.log"
  mkdir -p "$home/.claude" "$home/.codex"
  printf 'Home notes.\n' > "$home/AGENTS.md"
  printf 'Codex notes.\n' > "$home/.codex/AGENTS.md"
  if run_install conflict "$home" "" "$log"; then
    fail '[conflict] installer accepted separate instruction files'
    return
  fi
  [ "$(cat "$home/AGENTS.md")" = 'Home notes.' ] \
    || fail '[conflict] installer changed home instructions'
  [ "$(cat "$home/.codex/AGENTS.md")" = 'Codex notes.' ] \
    || fail '[conflict] installer changed Codex instructions'
}

run_hard_link_case() {
  local home="$WORK/home hard-link" log="$WORK/hard-link.log"
  mkdir -p "$home/.claude" "$home/.codex"
  printf 'Shared notes.\n' > "$home/AGENTS.md"
  ln "$home/AGENTS.md" "$home/.codex/AGENTS.md"
  if run_install hard-link "$home" "" "$log"; then
    fail '[hard-link] installer accepted links that its atomic rewrite would split'
    return
  fi
  [ "$(cat "$home/AGENTS.md")" = 'Shared notes.' ] \
    || fail '[hard-link] installer changed home instructions'
  [ "$(cat "$home/.codex/AGENTS.md")" = 'Shared notes.' ] \
    || fail '[hard-link] installer changed Codex instructions'
}

run_relative_link_case() {
  local home="$WORK/home relative-link" log="$WORK/relative-link.log"
  prepare_home "$home"
  rm "$home/.codex/AGENTS.md"
  ln -s ../dotfiles/agents.md "$home/.codex/AGENTS.md"
  if ! run_install relative-link "$home" "" "$log" \
     || ! run_install relative-link "$home" "" "$log"; then
    fail '[relative-link] installer treated two paths to one file as a conflict'
  fi
}

run_generic_only_case() {
  local home="$WORK/home generic-only" log="$WORK/generic-only.log"
  mkdir -p "$home/.agents"
  if ! run_install generic-only "$home" "" "$log"; then
    fail '[generic-only] install exited non-zero'
    return
  fi
  [ ! -e "$home/AGENTS.md" ] || fail '[generic-only] installer wrote instructions for an absent harness'
}

run_symlinked_settings_case() {
  local home="$WORK/home symlinked-settings" log="$WORK/symlinked-settings.log"
  prepare_home "$home"
  mv "$home/.claude/settings.json" "$home/dotfiles/settings.json"
  ln -s "$home/dotfiles/settings.json" "$home/.claude/settings.json"
  if ! run_install symlinked-settings "$home" "" "$log"; then
    fail '[symlinked-settings] install exited non-zero'
    return
  fi
  [ -L "$home/.claude/settings.json" ] \
    || fail '[symlinked-settings] install replaced the settings symlink'
  if ! run_install symlinked-settings "$home" "" "$log" --uninstall; then
    fail '[symlinked-settings] uninstall exited non-zero'
    return
  fi
  [ -L "$home/.claude/settings.json" ] \
    || fail '[symlinked-settings] uninstall replaced the settings symlink'
  python3 -c 'import json,sys; assert json.load(open(sys.argv[1])) == {"theme":"dark"}' \
    "$home/dotfiles/settings.json" || fail '[symlinked-settings] uninstall did not restore settings'
}

run_settings_conflict_case() {
  local home="$WORK/home settings-conflict" log="$WORK/settings-conflict.log"
  prepare_home "$home"
  printf '%s\n' '{"pluginConfigs":{"agents-md@builtin":{"options":{"instructionFiles":"claude-md"}}}}' \
    > "$home/.claude/settings.json"
  if run_install settings-conflict "$home" "" "$log"; then
    fail '[settings-conflict] installer overrode the selected Claude mode'
    return
  fi
  [ ! -e "$home/AGENTS.md" ] \
    || fail '[settings-conflict] installer created a link before rejecting Claude settings'
  python3 -c 'import json,sys; assert json.load(open(sys.argv[1]))["pluginConfigs"]["agents-md@builtin"]["options"]["instructionFiles"] == "claude-md"' \
    "$home/.claude/settings.json" || fail '[settings-conflict] installer changed Claude settings'
}

make_bsd_stat "$WORK/bin-bsd"
make_gnu_stat "$WORK/bin-gnu"
make_no_stat "$WORK/bin-none"

run_case system
run_case bsd-stat "$WORK/bin-bsd"
run_case gnu-stat "$WORK/bin-gnu"
run_refusal_case
run_regular_legacy_case
run_claude_only_case
run_fresh_shared_case
run_conflict_case
run_hard_link_case
run_relative_link_case
run_generic_only_case
run_symlinked_settings_case
run_settings_conflict_case

if [ "$failures" -ne 0 ]; then
  echo "$failures instruction-file check(s) failed." >&2
  exit 1
fi

echo "Instruction files survive reinstallation and uninstallation on every stat flavour."
