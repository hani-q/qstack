#!/usr/bin/env python3
"""Model catalogue, scores and tiers for /qstack-choose-model.

Subcommands print JSON on stdout so a skill can read them without parsing prose.

  discover            the models this machine can reach, and where the list came from
  score               the catalogue joined with Artificial Analysis coding index and price
  tier                the strong / standard / cheap map for a run, minus the orchestrator
  resolve NAME        the catalogue id a user's spelling means, or the closest three
  probe-brief ID      the one-line task to send a model to prove it can be launched

Discovery order, first hit wins: QSTACK_MODELS_URL when set; the base URLs the
CLIs already trust (Codex model_provider base_url, ANTHROPIC_BASE_URL,
OPENAI_BASE_URL) via GET /v1/models; then the harness's built-in list. Nothing
is hardcoded except where to look.

Scores come from the Artificial Analysis Data API free tier when
ARTIFICIAL_ANALYSIS_API_KEY (or ~/.config/qstack/artificial-analysis.key) is
present, cached for a day under ~/.cache/qstack/. Without a key the tier map
falls back to a static ordering shipped below and says so.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "qstack"
CACHE_TTL = 24 * 3600
AA_URL = "https://artificialanalysis.ai/api/v2/data/llms/models"

# What each harness can launch by name when no catalogue is reachable. The
# Claude Code Agent tool takes a fixed enum. Codex takes whatever ids its
# provider serves, so with no reachable provider it has no list and the caller
# asks. Detection: QSTACK_HARNESS wins; else CLAUDECODE, which Claude Code sets
# in its shell; else unknown, which also yields an empty list.
HARNESS_BUILTIN = {
    "claude-code": ["fable", "opus", "sonnet", "haiku"],
    "codex": [],
    "unknown": [],
}

# Used only when no scores can be fetched. Strong to cheap. Say so in output.
STATIC_ORDER = [
    "claude-fable-5-1", "gpt-6-astra", "claude-opus-5", "gpt-5.6-sol",
    "grok-4.6", "claude-sonnet-5", "gpt-5.6-luna", "claude-haiku-4-5",
]


def norm(s: str) -> str:
    return re.sub(r"[^a-z0-9]", "", s.lower())


def http_json(url: str, headers: dict[str, str] | None = None, timeout: float = 6.0):
    req = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def cached(name: str, fetch):
    CACHE.mkdir(parents=True, exist_ok=True)
    p = CACHE / name
    if p.exists() and time.time() - p.stat().st_mtime < CACHE_TTL:
        return json.loads(p.read_text()), True
    data = fetch()
    p.write_text(json.dumps(data))
    return data, False


def codex_base_url() -> str | None:
    cfg = Path.home() / ".codex" / "config.toml"
    if not cfg.exists():
        return None
    text = cfg.read_text()
    m = re.search(r'^model_provider\s*=\s*"([^"]+)"', text, re.M)
    if not m:
        return None
    sect = re.search(
        r"\[model_providers\." + re.escape(m.group(1)) + r"\](.*?)(?=^\[|\Z)", text, re.M | re.S
    )
    if not sect:
        return None
    u = re.search(r'^base_url\s*=\s*"([^"]+)"', sect.group(1), re.M)
    return u.group(1) if u else None


def cliproxy_key_for(base: str) -> str | None:
    """CLIProxyAPI's own key, and only for the host and port its config names."""
    cfg = Path.home() / ".cli-proxy-api" / "config.yaml"
    if not cfg.exists():
        return None
    text = cfg.read_text()
    port = re.search(r"^port:\s*(\d+)", text, re.M)
    host = urllib.parse.urlsplit(base).hostname or ""
    if host not in ("127.0.0.1", "localhost", "::1"):
        return None
    if port and urllib.parse.urlsplit(base).port != int(port.group(1)):
        return None
    m = re.search(r"^api-keys:\s*\n\s*-\s*\"?([^\"\s]+)", text, re.M)
    return m.group(1) if m else None


def api_key_for(source: str, base: str) -> tuple[str, str] | None:
    """The (header, key) pair that belongs to this source. A key is never sent
    to a host it was not issued for, so an override URL gets only its own key."""
    env = os.environ
    if source == "QSTACK_MODELS_URL":
        k = env.get("QSTACK_MODELS_KEY")
        return ("Authorization", f"Bearer {k}") if k else None
    if source == "OPENAI_BASE_URL":
        k = env.get("OPENAI_API_KEY")
        return ("Authorization", f"Bearer {k}") if k else None
    if source == "ANTHROPIC_BASE_URL":
        k = env.get("ANTHROPIC_AUTH_TOKEN") or env.get("ANTHROPIC_API_KEY")
        if k:
            return ("x-api-key", k)
    # Codex's provider and Anthropic's base may both be the local CLIProxyAPI.
    k = cliproxy_key_for(base)
    return ("Authorization", f"Bearer {k}") if k else None


def list_models(source: str, base: str) -> list[str] | None:
    base = base.rstrip("/")
    url = base + ("/models" if base.endswith("/v1") else "/v1/models")
    headers = {}
    auth = api_key_for(source, base)
    if auth:
        headers[auth[0]] = auth[1]
    try:
        d = http_json(url, headers)
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError, OSError):
        return None
    items = d.get("data", d if isinstance(d, list) else [])
    ids = sorted({str(m.get("id") or m.get("name")) for m in items if isinstance(m, dict)})
    return ids or None


def discover() -> dict:
    tried = []
    for source, base in (
        ("QSTACK_MODELS_URL", os.environ.get("QSTACK_MODELS_URL")),
        ("codex model_provider", codex_base_url()),
        ("ANTHROPIC_BASE_URL", os.environ.get("ANTHROPIC_BASE_URL")),
        ("OPENAI_BASE_URL", os.environ.get("OPENAI_BASE_URL")),
    ):
        if not base:
            continue
        tried.append(f"{source}={base}")
        ids = list_models(source, base)
        if ids:
            return {"source": source, "url": base, "models": ids, "tried": tried}
    harness = os.environ.get("QSTACK_HARNESS") or ("claude-code" if os.environ.get("CLAUDECODE") else "unknown")
    if harness not in HARNESS_BUILTIN:
        harness = "unknown"
    return {"source": f"harness builtin ({harness})", "url": None, "models": HARNESS_BUILTIN[harness], "tried": tried}


def aa_key() -> str | None:
    if os.environ.get("ARTIFICIAL_ANALYSIS_API_KEY"):
        return os.environ["ARTIFICIAL_ANALYSIS_API_KEY"]
    p = Path.home() / ".config" / "qstack" / "artificial-analysis.key"
    return p.read_text().strip() if p.exists() else None


def aa_scores() -> tuple[dict[str, dict], str]:
    key = aa_key()
    if not key:
        return {}, "no ARTIFICIAL_ANALYSIS_API_KEY; static ordering"
    def fetch():
        d = http_json(AA_URL, {"x-api-key": key}, timeout=20)
        out = {}
        for m in d.get("data", []):
            ev = m.get("evaluations") or {}
            pr = m.get("pricing") or {}
            out[m["slug"]] = {
                "name": m.get("name"),
                "coding": ev.get("artificial_analysis_coding_index"),
                "intelligence": ev.get("artificial_analysis_intelligence_index"),
                "agentic": ev.get("artificial_analysis_agentic_index"),
                "price_out": pr.get("price_1m_output_tokens"),
                "price_in": pr.get("price_1m_input_tokens"),
            }
        return out
    try:
        data, hit = cached("artificial-analysis.json", fetch)
    except (urllib.error.URLError, OSError, KeyError) as e:
        return {}, f"Artificial Analysis unreachable ({e.__class__.__name__}); static ordering"
    return data, f"Artificial Analysis Data API{' (cached)' if hit else ''}, {time.strftime('%Y-%m-%d')}"


EFFORT_SUFFIX = re.compile(r"-(x?high|medium|low|non-reasoning|reasoning|thinking|adaptive)$")
DATE_SUFFIX = re.compile(r"-?\d{8}$")


def tokens(s: str) -> tuple[str, ...]:
    """Order-free identity: `claude-haiku-4-5-20251001` and `claude-4-5-haiku`
    both become ('4','5','claude','haiku'). Dates and effort suffixes drop."""
    s = DATE_SUFFIX.sub("", EFFORT_SUFFIX.sub("", s.lower()))
    return tuple(sorted(t for t in re.split(r"[^a-z0-9]+", s.replace(".", "-")) if t))


EFFORTS = ("xhigh", "high", "medium", "low")


def effort_variants(slug: str, scores: dict[str, dict]) -> dict[str, dict]:
    """The per-effort rows AA publishes for a base slug: {'high': row, ...}.
    The base row itself is the provider's default effort, keyed 'default'."""
    out = {"default": scores[slug]} if slug in scores else {}
    for e in EFFORTS:
        row = scores.get(f"{slug}-{e}")
        if row and row.get("coding") is not None:
            out[e] = row
    return out


def match_score(model_id: str, scores: dict[str, dict]) -> dict | None:
    """Catalogue ids and AA slugs spell differently (gpt-5.6-sol vs gpt-5-6-sol,
    claude-haiku-4-5-20251001 vs claude-4-5-haiku). Three passes: normalised
    exact, normalised prefix on a base variant, then order-free token set."""
    n = norm(model_id)
    exact = [s for s in scores if norm(s) == n]
    if exact:
        return scores[exact[0]] | {"slug": exact[0]}
    base = [s for s in scores if not EFFORT_SUFFIX.search(s)]
    cands = [s for s in base if norm(s).startswith(n)]
    if cands:
        s = sorted(cands, key=len)[0]
        return scores[s] | {"slug": s}
    t = tokens(model_id)
    cands = [s for s in base if tokens(s) == t]
    if cands:
        s = sorted(cands, key=len)[0]
        return scores[s] | {"slug": s}
    return None


def score() -> dict:
    cat = discover()
    scores, src = aa_scores()
    rows = []
    for mid in cat["models"]:
        if re.search(r"image|video|imagine|embed|auto-review|composer", mid):
            continue
        s = match_score(mid, scores) if scores else None
        if s is None and not scores:
            rank = next((i for i, x in enumerate(STATIC_ORDER) if norm(x) in norm(mid) or norm(mid) in norm(x)), None)
            s = {"coding": (len(STATIC_ORDER) - rank) if rank is not None else None, "price_out": None, "slug": None}
        row = {"id": mid, **(s or {"coding": None, "price_out": None, "slug": None})}
        if s and s.get("slug") and scores:
            row["efforts"] = {e: v["coding"] for e, v in effort_variants(s["slug"], scores).items()}
        rows.append(row)
    return {"catalogue": cat, "scores_source": src, "models": rows}


def tier(orchestrator: str | None) -> dict:
    sc = score()
    rows = [r for r in sc["models"] if r.get("coding") is not None]
    if orchestrator:
        rows = [r for r in rows if norm(orchestrator) not in norm(r["id"]) and norm(r["id"]) not in norm(orchestrator)]
    if not rows:
        return {"error": "no scored models", **sc}
    # A tier is a (model, effort) pair. AA scores each effort separately and the
    # spread is large: a model at `low` can lose 25 index points, so an effort
    # label bolted onto a model chosen at default effort picks the wrong cell.
    # Efforts a launcher can name are high/medium/low; a provider's default row
    # is reported as the nearest of those when it scores better.
    LAUNCHABLE = ("high", "medium", "low")

    def pairs(r):
        """One cell per launchable effort for this model, best score each.
        AA's `default` and `xhigh` rows have no launcher setting of their own;
        they stand in for `high` when they score better than the high row."""
        eff = {e: c for e, c in (r.get("efforts") or {"default": r["coding"]}).items() if c is not None}
        best = {}
        for e, c in eff.items():
            name = e if e in LAUNCHABLE else "high"
            if name not in best or c > best[name]:
                best[name] = c
        return [{**r, "reasoning": name, "coding": c} for name, c in best.items()]

    cells = [p for r in rows for p in pairs(r)]
    if not cells:
        return {"error": "no scored models", **sc}
    by_coding = sorted(cells, key=lambda c: -c["coding"])
    strong = by_coding[0]
    top = strong["coding"]
    floor = top - 20
    # cheap: the least expensive cell within 20 points of the top; ties on price
    # go to the higher score, so a model's best effort wins over its worst.
    priced = [c for c in cells if c.get("price_out") is not None and c["coding"] >= floor and c["id"] != strong["id"]]
    cheap = sorted(priced, key=lambda c: (c["price_out"], -c["coding"]))[0] if priced else by_coding[-1]
    # standard: best remaining cell on a third model when one exists, else the
    # best remaining effort of the two already chosen.
    others = [c for c in by_coding if c["id"] not in (strong["id"], cheap["id"])]
    standard = others[0] if others else next((c for c in by_coding if c is not strong and c is not cheap), cheap)
    return {
        "orchestrator_excluded": orchestrator,
        "scores_source": sc["scores_source"],
        "catalogue_source": sc["catalogue"]["source"],
        "tiers": {k: v["id"] for k, v in (("strong", strong), ("standard", standard), ("cheap", cheap))},
        "reasoning": {k: v["reasoning"] for k, v in (("strong", strong), ("standard", standard), ("cheap", cheap))},
        "detail": {"strong": strong, "standard": standard, "cheap": cheap},
    }


def resolve(name: str) -> dict:
    cat = discover()
    n = norm(name)
    exact = [m for m in cat["models"] if norm(m) == n]
    if exact:
        return {"resolved": exact[0], "source": cat["source"]}
    contain = [m for m in cat["models"] if n in norm(m) or norm(m) in n]
    if len(contain) == 1:
        return {"resolved": contain[0], "source": cat["source"]}
    def dist(a: str, b: str) -> int:
        # small Levenshtein, enough for slugs
        prev = list(range(len(b) + 1))
        for i, ca in enumerate(a, 1):
            cur = [i]
            for j, cb in enumerate(b, 1):
                cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
            prev = cur
        return prev[-1]
    closest = contain[:3] if contain else sorted(cat["models"], key=lambda m: dist(n, norm(m)))[:3]
    return {"resolved": None, "ambiguous": contain, "closest": closest, "source": cat["source"]}


def main() -> int:
    ap = argparse.ArgumentParser(prog="qstack-models")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("discover")
    sub.add_parser("score")
    t = sub.add_parser("tier"); t.add_argument("--orchestrator")
    r = sub.add_parser("resolve"); r.add_argument("name")
    pb = sub.add_parser("probe-brief"); pb.add_argument("id")
    a = ap.parse_args()
    if a.cmd == "discover": out = discover()
    elif a.cmd == "score": out = score()
    elif a.cmd == "tier": out = tier(a.orchestrator)
    elif a.cmd == "resolve": out = resolve(a.name)
    else:
        out = {"model": a.id, "effort": "low",
               "task": f"Reply with exactly two words: PONG and the model id you are running as. Do not read or write any file. Expected id: {a.id}."}
    json.dump(out, sys.stdout, indent=2); print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
