#!/usr/bin/env python3
"""Model catalogue, scores and tiers for /qstack-choose-model.

Subcommands print JSON on stdout so a skill can read them without parsing prose.

  discover            the models this machine can reach, and where the list came from
  score               the catalogue joined with Artificial Analysis coding index and price
  tier                the strong / standard / cheap map for a run, minus the orchestrator
  resolve NAME        the catalogue id a user's spelling means, or the closest three
  probe-brief ID      the one-line task to send a model to prove it can be launched

Discovery order, first hit wins: QSTACK_MODELS_URL when set; the base URLs the
CLIs already trust (Codex model_provider base_url, ANTHROPIC_BASE_URL,
OPENAI_BASE_URL) via GET /v1/models; then the harness's built-in list. Nothing
is hardcoded except where to look.

Scores come from the Artificial Analysis Data API free tier when
ARTIFICIAL_ANALYSIS_API_KEY (or ~/.config/qstack/artificial-analysis.key) is
present, cached for a day under ~/.cache/qstack/. Without a key the tier map
falls back to a static ordering shipped below and says so.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "qstack"
CACHE_TTL = 24 * 3600
AA_URL = "https://artificialanalysis.ai/api/v2/data/llms/models"

# What each harness can launch by name when no catalogue is reachable. The
# Claude Code Agent tool takes a fixed enum; Codex takes its provider's ids.
HARNESS_BUILTIN = {
    "claude-code": ["fable", "opus", "sonnet", "haiku"],
    "codex": ["gpt-5.6-sol", "gpt-5.6-luna", "gpt-5.5"],
}

# Used only when no scores can be fetched. Strong to cheap. Say so in output.
STATIC_ORDER = [
    "claude-fable-5-1", "gpt-6-astra", "claude-opus-5", "gpt-5.6-sol",
    "grok-4.6", "claude-sonnet-5", "gpt-5.6-luna", "claude-haiku-4-5",
]


def norm(s: str) -> str:
    return re.sub(r"[^a-z0-9]", "", s.lower())


def http_json(url: str, headers: dict[str, str] | None = None, timeout: float = 6.0):
    req = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def cached(name: str, fetch):
    CACHE.mkdir(parents=True, exist_ok=True)
    p = CACHE / name
    if p.exists() and time.time() - p.stat().st_mtime < CACHE_TTL:
        return json.loads(p.read_text()), True
    data = fetch()
    p.write_text(json.dumps(data))
    return data, False


def codex_base_url() -> str | None:
    cfg = Path.home() / ".codex" / "config.toml"
    if not cfg.exists():
        return None
    text = cfg.read_text()
    m = re.search(r'^model_provider\s*=\s*"([^"]+)"', text, re.M)
    if not m:
        return None
    sect = re.search(
        r"\[model_providers\." + re.escape(m.group(1)) + r"\](.*?)(?=^\[|\Z)", text, re.M | re.S
    )
    if not sect:
        return None
    u = re.search(r'^base_url\s*=\s*"([^"]+)"', sect.group(1), re.M)
    return u.group(1) if u else None


def api_key_for(base: str) -> str | None:
    # CLIProxyAPI keys live in its config; the CLIs hold their own copies.
    for var in ("OPENAI_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_API_KEY"):
        if os.environ.get(var):
            return os.environ[var]
    cfg = Path.home() / ".cli-proxy-api" / "config.yaml"
    if cfg.exists() and ("127.0.0.1" in base or "localhost" in base):
        m = re.search(r"^api-keys:\s*\n\s*-\s*\"?([^\"\s]+)", cfg.read_text(), re.M)
        if m:
            return m.group(1)
    return None


def list_models(base: str) -> list[str] | None:
    base = base.rstrip("/")
    url = base + ("/models" if base.endswith("/v1") else "/v1/models")
    headers = {}
    key = api_key_for(base)
    if key:
        headers["Authorization"] = f"Bearer {key}"
        headers["x-api-key"] = key
    try:
        d = http_json(url, headers)
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError, OSError):
        return None
    items = d.get("data", d if isinstance(d, list) else [])
    ids = sorted({str(m.get("id") or m.get("name")) for m in items if isinstance(m, dict)})
    return ids or None


def discover() -> dict:
    tried = []
    for source, base in (
        ("QSTACK_MODELS_URL", os.environ.get("QSTACK_MODELS_URL")),
        ("codex model_provider", codex_base_url()),
        ("ANTHROPIC_BASE_URL", os.environ.get("ANTHROPIC_BASE_URL")),
        ("OPENAI_BASE_URL", os.environ.get("OPENAI_BASE_URL")),
    ):
        if not base:
            continue
        tried.append(f"{source}={base}")
        ids = list_models(base)
        if ids:
            return {"source": source, "url": base, "models": ids, "tried": tried}
    harness = "claude-code" if os.environ.get("CLAUDECODE") or os.environ.get("CLAUDE_CODE") else "codex" if Path.home().joinpath(".codex").exists() else "claude-code"
    return {"source": f"harness builtin ({harness})", "url": None, "models": HARNESS_BUILTIN[harness], "tried": tried}


def aa_key() -> str | None:
    if os.environ.get("ARTIFICIAL_ANALYSIS_API_KEY"):
        return os.environ["ARTIFICIAL_ANALYSIS_API_KEY"]
    p = Path.home() / ".config" / "qstack" / "artificial-analysis.key"
    return p.read_text().strip() if p.exists() else None


def aa_scores() -> tuple[dict[str, dict], str]:
    key = aa_key()
    if not key:
        return {}, "no ARTIFICIAL_ANALYSIS_API_KEY; static ordering"
    def fetch():
        d = http_json(AA_URL, {"x-api-key": key}, timeout=20)
        out = {}
        for m in d.get("data", []):
            ev = m.get("evaluations") or {}
            pr = m.get("pricing") or {}
            out[m["slug"]] = {
                "name": m.get("name"),
                "coding": ev.get("artificial_analysis_coding_index"),
                "intelligence": ev.get("artificial_analysis_intelligence_index"),
                "agentic": ev.get("artificial_analysis_agentic_index"),
                "price_out": pr.get("price_1m_output_tokens"),
                "price_in": pr.get("price_1m_input_tokens"),
            }
        return out
    try:
        data, hit = cached("artificial-analysis.json", fetch)
    except (urllib.error.URLError, OSError, KeyError) as e:
        return {}, f"Artificial Analysis unreachable ({e.__class__.__name__}); static ordering"
    return data, f"Artificial Analysis Data API{' (cached)' if hit else ''}, {time.strftime('%Y-%m-%d')}"


def match_score(model_id: str, scores: dict[str, dict]) -> dict | None:
    """Catalogue ids and AA slugs spell differently (gpt-5.6-sol vs gpt-5-6-sol).
    Match on normalised form; prefer the base variant over -high/-low ones."""
    n = norm(model_id)
    exact = [s for s in scores if norm(s) == n]
    if exact:
        return scores[exact[0]] | {"slug": exact[0]}
    cands = [s for s in scores if norm(s).startswith(n) and not re.search(r"-(x?high|medium|low|non-reasoning|thinking)$", s)]
    if cands:
        s = sorted(cands, key=len)[0]
        return scores[s] | {"slug": s}
    return None


def score() -> dict:
    cat = discover()
    scores, src = aa_scores()
    rows = []
    for mid in cat["models"]:
        if re.search(r"image|video|imagine|embed|auto-review|composer", mid):
            continue
        s = match_score(mid, scores) if scores else None
        if s is None and not scores:
            rank = next((i for i, x in enumerate(STATIC_ORDER) if norm(x) in norm(mid) or norm(mid) in norm(x)), None)
            s = {"coding": (len(STATIC_ORDER) - rank) if rank is not None else None, "price_out": None, "slug": None}
        rows.append({"id": mid, **(s or {"coding": None, "price_out": None, "slug": None})})
    return {"catalogue": cat, "scores_source": src, "models": rows}


def tier(orchestrator: str | None) -> dict:
    sc = score()
    rows = [r for r in sc["models"] if r.get("coding") is not None]
    if orchestrator:
        rows = [r for r in rows if norm(orchestrator) not in norm(r["id"]) and norm(r["id"]) not in norm(orchestrator)]
    if not rows:
        return {"error": "no scored models", **sc}
    by_coding = sorted(rows, key=lambda r: -r["coding"])
    strong = by_coding[0]
    top = strong["coding"]
    # cheap: lowest output price among models within 20 index points of the top,
    # so "cheap" still means competent; standard: best remaining below strong.
    floor = top - 20
    priced = [r for r in rows if r.get("price_out") is not None and r["coding"] >= floor and r is not strong]
    cheap = sorted(priced, key=lambda r: (r["price_out"], -r["coding"]))[0] if priced else by_coding[-1]
    standard = next((r for r in by_coding if r is not strong and r is not cheap), cheap)
    return {
        "orchestrator_excluded": orchestrator,
        "scores_source": sc["scores_source"],
        "catalogue_source": sc["catalogue"]["source"],
        "tiers": {"strong": strong["id"], "standard": standard["id"], "cheap": cheap["id"]},
        "detail": {"strong": strong, "standard": standard, "cheap": cheap},
        "reasoning_default": {"strong": "high", "standard": "medium", "cheap": "low"},
    }


def resolve(name: str) -> dict:
    cat = discover()
    n = norm(name)
    exact = [m for m in cat["models"] if norm(m) == n]
    if exact:
        return {"resolved": exact[0], "source": cat["source"]}
    contain = [m for m in cat["models"] if n in norm(m) or norm(m) in n]
    if len(contain) == 1:
        return {"resolved": contain[0], "source": cat["source"]}
    def dist(a: str, b: str) -> int:
        # small Levenshtein, enough for slugs
        prev = list(range(len(b) + 1))
        for i, ca in enumerate(a, 1):
            cur = [i]
            for j, cb in enumerate(b, 1):
                cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
            prev = cur
        return prev[-1]
    closest = sorted(cat["models"], key=lambda m: dist(n, norm(m)))[:3]
    return {"resolved": None, "ambiguous": contain, "closest": closest, "source": cat["source"]}


def main() -> int:
    ap = argparse.ArgumentParser(prog="qstack-models")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("discover")
    sub.add_parser("score")
    t = sub.add_parser("tier"); t.add_argument("--orchestrator")
    r = sub.add_parser("resolve"); r.add_argument("name")
    pb = sub.add_parser("probe-brief"); pb.add_argument("id")
    a = ap.parse_args()
    if a.cmd == "discover": out = discover()
    elif a.cmd == "score": out = score()
    elif a.cmd == "tier": out = tier(a.orchestrator)
    elif a.cmd == "resolve": out = resolve(a.name)
    else:
        out = {"model": a.id, "effort": "low",
               "task": f"Reply with exactly two words: PONG and the model id you are running as. Do not read or write any file. Expected id: {a.id}."}
    json.dump(out, sys.stdout, indent=2); print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
