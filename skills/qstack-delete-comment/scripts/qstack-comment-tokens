#!/usr/bin/env python3
"""List comments, and prove that a comment sweep changed nothing but comments.

  qstack-comment-tokens list PATH...
      Print every comment in the files under PATH that a built-in lexer
      handles, as JSON lines: {"id": "path:start", "file", "start_line",
      "end_line", "text"}.

  qstack-comment-tokens check [-C REPO] [--lexer FILE] BASE [HEAD]
      Compare the non-comment token stream of every file changed between BASE
      and HEAD (default: the working tree) and exit 1 on any difference.

Built-in lexers: C, C++ and Objective-C (string and character literals stay
whole, line splices are joined, and the end of a preprocessor directive is a
token, so a lost backslash continuation is caught), and Python (the standard
tokenize module, ignoring COMMENT and NL). For any other language pass
--lexer FILE, a Python file defining code_tokens(text, path) that returns the
file's non-comment tokens as a list of strings, or None for a path it does not
handle.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import io
import json
import subprocess
import sys
import tokenize
from pathlib import Path

C_SUFFIXES = {".c", ".h", ".cc", ".cpp", ".cxx", ".hh", ".hpp", ".hxx", ".m", ".mm", ".inc"}
PY_SUFFIXES = {".py", ".pyi"}
NON_SOURCE_SUFFIXES = {".md", ".markdown", ".rst", ".adoc", ".txt", ".json", ".yml", ".yaml", ".toml"}
DIRECTIVE_END = "<end-of-directive>"


def scan_c(text: str) -> tuple[list[dict], list[str]]:
    """Return (comments, code tokens) for C-family source."""
    comments: list[dict] = []
    tokens: list[str] = []
    word: list[str] = []
    i, n, line = 0, len(text), 1
    line_start = True
    in_directive = False

    def splice_at(j: int) -> int:
        if text.startswith("\\\n", j):
            return 2
        if text.startswith("\\\r\n", j):
            return 3
        return 0

    def end_word() -> None:
        if word:
            tokens.append("".join(word))
            word.clear()

    while i < n:
        c = text[i]
        skip = splice_at(i)
        if skip:
            line += 1
            i += skip
        elif c == "\n":
            end_word()
            if in_directive:
                tokens.append(DIRECTIVE_END)
                in_directive = False
            line_start = True
            line += 1
            i += 1
        elif c in " \t\r\f\v":
            end_word()
            i += 1
        elif c in "\"'":
            start = i
            i += 1
            while i < n:
                skip = splice_at(i)
                if skip:
                    line += 1
                    i += skip
                elif text[i] == "\\":
                    i += 2
                elif text[i] == "\n":
                    break
                elif text[i] == c:
                    i += 1
                    break
                else:
                    i += 1
            word.append(text[start:i].replace("\\\r\n", "").replace("\\\n", ""))
            line_start = False
        elif text.startswith("//", i) or text.startswith("/*", i):
            end_word()
            start, start_line = i, line
            if text[i + 1] == "/":
                while i < n and text[i] != "\n":
                    skip = splice_at(i)
                    if skip:
                        line += 1
                        i += skip
                    else:
                        i += 1
            else:
                end = text.find("*/", i + 2)
                end = n if end < 0 else end + 2
                line += text.count("\n", i, end)
                i = end
            body = text[start:i].rstrip("\r")
            comments.append({"start_line": start_line, "end_line": line, "text": body})
        else:
            if line_start and c == "#":
                in_directive = True
            line_start = False
            word.append(c)
            i += 1
    end_word()
    if in_directive:
        tokens.append(DIRECTIVE_END)
    return comments, tokens


def scan_python(text: str) -> tuple[list[dict], list[str]]:
    comments: list[dict] = []
    tokens: list[str] = []
    layout = {tokenize.NEWLINE, tokenize.NL, tokenize.ENDMARKER}
    for tok in tokenize.generate_tokens(io.StringIO(text).readline):
        if tok.type == tokenize.COMMENT:
            comments.append({"start_line": tok.start[0], "end_line": tok.end[0], "text": tok.string})
        elif tok.type == tokenize.NL:
            continue
        elif tok.type in layout:
            tokens.append(tokenize.tok_name[tok.type])
        else:
            tokens.append(f"{tokenize.tok_name[tok.type]}:{tok.string}")
    return comments, tokens


def load_lexer(path: str | None):
    if not path:
        return None
    loader = importlib.machinery.SourceFileLoader("qstack_custom_lexer", str(Path(path).resolve()))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    if not hasattr(module, "code_tokens"):
        sys.exit(f"{path}: defines no code_tokens(text, path)")
    return module


def code_tokens(text: str, path: str, lexer) -> list[str] | None:
    if lexer is not None:
        result = lexer.code_tokens(text, path)
        if result is not None:
            return list(result)
    suffix = Path(path).suffix.lower()
    if suffix in C_SUFFIXES:
        return scan_c(text)[1]
    if suffix in PY_SUFFIXES:
        return scan_python(text)[1]
    return None


def cmd_list(args) -> int:
    files: list[Path] = []
    for raw in args.paths:
        p = Path(raw)
        files += sorted(f for f in p.rglob("*") if f.is_file()) if p.is_dir() else [p]
    for f in files:
        suffix = f.suffix.lower()
        if suffix not in C_SUFFIXES | PY_SUFFIXES:
            continue
        text = f.read_text(encoding="utf-8", errors="replace")
        comments = scan_c(text)[0] if suffix in C_SUFFIXES else scan_python(text)[0]
        for c in comments:
            rel = f.as_posix()
            print(json.dumps({"id": f"{rel}:{c['start_line']}", "file": rel, **c}))
    return 0


def git(repo: str, *args: str) -> str:
    return subprocess.run(
        ["git", "-C", repo, *args], capture_output=True, check=True, text=True,
        encoding="utf-8", errors="replace",
    ).stdout


def first_difference(a: list[str], b: list[str]) -> str:
    i = next((k for k, (x, y) in enumerate(zip(a, b)) if x != y), min(len(a), len(b)))
    return f"token {i}: before {a[i:i + 4]!r}, after {b[i:i + 4]!r}"


def cmd_check(args) -> int:
    repo, lexer = args.repo, load_lexer(args.lexer)
    diff = ["diff", "--name-status", "--no-renames", args.base] + ([args.head] if args.head else [])
    failed = checked = 0
    for row in git(repo, *diff).splitlines():
        status, path = row.split("\t", 1)
        suffix = Path(path).suffix.lower()
        if suffix in NON_SOURCE_SUFFIXES:
            print(f"not source  {path}")
            continue
        if status != "M":
            print(f"FAIL        {path}: {'added' if status == 'A' else 'deleted'} (a comment sweep only modifies files)")
            failed += 1
            continue
        before = git(repo, "show", f"{args.base}:{path}")
        after = (
            git(repo, "show", f"{args.head}:{path}") if args.head
            else (Path(repo) / path).read_text(encoding="utf-8", errors="replace")
        )
        a, b = code_tokens(before, path, lexer), code_tokens(after, path, lexer)
        if a is None:
            print(f"FAIL        {path}: no lexer for {suffix or 'this file'}; pass --lexer")
            failed += 1
        elif a != b:
            print(f"FAIL        {path}: {first_difference(a, b)}")
            failed += 1
        else:
            checked += 1
    print(f"{checked} file(s) token-identical, {failed} failure(s)")
    return 1 if failed else 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    p_list = sub.add_parser("list", help="print comments as JSON lines")
    p_list.add_argument("paths", nargs="+")
    p_check = sub.add_parser("check", help="prove only comments changed")
    p_check.add_argument("-C", dest="repo", default=".")
    p_check.add_argument("--lexer")
    p_check.add_argument("base")
    p_check.add_argument("head", nargs="?")
    args = parser.parse_args()
    return cmd_list(args) if args.command == "list" else cmd_check(args)


if __name__ == "__main__":
    raise SystemExit(main())
